# Secrets and personal data
# (gitignore has no inline comments — keep notes on their own lines)
.env
.env.local
.env.*.local
# her filled CV — name, address, contact details
pool.yaml
pool.yaml.bak
# Anything the app writes beside her CV — a rescued copy is still her CV.
pool.yaml.*
!pool.template.yaml
# her original CV documents never leave this machine
*.docx

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
build/
.next/

# Runtime data (provider health, daily counters, caches)
data/

# OS
.DS_Store
Thumbs.db

# Crash dumps
*.stackdump
