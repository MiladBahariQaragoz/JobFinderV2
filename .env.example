# Generated by `python -m llmpool env`. Fill in the keys you have —
# any left blank are skipped, so a partial list still runs.

# groq — https://console.groq.com/keys
#   0.6s — fastest in the pool. No card required.
GROQ_API_KEY=

# google — https://aistudio.google.com/apikey
#   1.7s. AI Studio free tier via its OpenAI-compatible endpoint, no card. Avoid the gemma-* models here — they leak <thought> blocks into content.
GEMINI_API_KEY=

# cerebras — https://cloud.cerebras.ai
#   0.8s. Catalog is small and churns — expect to rotate models.
CEREBRAS_API_KEY=

# ollama — https://ollama.com/settings/keys
#   1.0s. Ollama Cloud free tier — session/weekly caps rather than RPM.
OLLAMA_API_KEY=

# mistral — https://console.mistral.ai/api-keys
#   0.9s. Recovers faster than anything else after a rate limit.
MISTRAL_API_KEY=

# cloudflare — https://dash.cloudflare.com/profile/api-tokens (needs Workers AI scope)
#   1.4s. Needs CLOUDFLARE_ACCOUNT_ID too — the base_url interpolates it from the environment. Does not expose /models, so drift can't be checked.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# kilo — https://app.kilo.ai
#   1.8s on the poolside route. Most other :free routes are reasoning models that spend the whole token budget thinking and return empty content — prefer 
KILO_API_KEY=

# huggingface — https://huggingface.co/settings/tokens
#   1.4s. Credit-metered (~100K tokens/month) — exhausts fast under load.
HUGGINGFACE_API_KEY=

# sambanova — https://cloud.sambanova.ai/apis
#   1.8s when it answers. Its bigger model pools frequently return 429 "currently experiencing high demand" — that is congestion, not your key.
SAMBANOVA_API_KEY=

# cohere — https://dashboard.cohere.com/api-keys
#   0.8s. Trial key is non-commercial. The monthly cap is the binding limit.
COHERE_API_KEY=

# openrouter — https://openrouter.ai/keys
#   2.5s. One key, ~20 rotating :free routes. Which slugs are free changes often (the llama-3.3 :free slug was retired) — run `doctor --drift`.
OPENROUTER_API_KEY=

# zhipu — https://open.bigmodel.cn
#   10-50s — by far the slowest. The free -flash models work but are absent from /models, so drift reports a false positive for them. Errors come back in 
ZHIPU_API_KEY=

# aion — https://www.aionlabs.ai
#   3-40s. Tiny daily token budget; it will 429 with 'Daily token limit exceeded'.
AION_API_KEY=

# nvidia — https://build.nvidia.com
#   6-40s, and frequently 503 "Worker local total request limit reached". Evaluation-scoped tier. Keep it late in the list.
NVIDIA_API_KEY=

# fireworks — https://fireworks.ai/account/api-keys
#   1.1s. NOT a free tier — this runs on signup trial credit and will die when that runs out. Treat as bonus capacity, never as a dependency.
FIREWORKS_API_KEY=

# siliconflow  (disabled in catalog) — https://cloud.siliconflow.com
#   Key authenticates and /models lists 75 models, but every completion returns 403 "account balance is insufficient". Enable once the account has credit.
SILICONFLOW_API_KEY=
